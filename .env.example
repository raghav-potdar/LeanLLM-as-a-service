# Copy this file to .env and adjust values before running docker compose.
#
# CPU mode (default):
#   LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
#   LLAMA_GPU_LAYERS=0
#   DOCKER_RUNTIME=runc
#   LLAMA_GPU_COUNT=0
#
# GPU mode (NVIDIA):
#   LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
#   LLAMA_GPU_LAYERS=99
#   DOCKER_RUNTIME=nvidia
#   LLAMA_GPU_COUNT=1
#   (set LLAMA_CTX_SIZE=8192 and LLAMA_PARALLEL=4 for larger VRAM GPUs)

# llama.cpp Docker image to use
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Number of layers to offload to GPU (0 = CPU-only, 99 = all layers on GPU)
LLAMA_GPU_LAYERS=0

# Number of CPU threads for token generation
LLAMA_THREADS=2

# Context window size (tokens)
LLAMA_CTX_SIZE=4096

# Number of parallel request slots
LLAMA_PARALLEL=1

# Docker runtime: runc (CPU) or nvidia (GPU)
DOCKER_RUNTIME=runc

# Number of GPUs to reserve (0 = none, 1 = single GPU)
LLAMA_GPU_COUNT=0
